{
  "name": "@qualitygb/padron-pdf",
  "version": "0.2.1",
  "description": "Generador de padrones electorales en PDF (datos + foto del ciudadano), plug-and-play. Lectura por lotes (keyset), PDFKit en streaming, storage configurable (local / S3 / Bunny / Railway), diseño por defecto y marca del partido.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "ejemplo": "node --import tsx ejemplo/partido.ts",
    "prepare": "tsup",
    "ejemplo:partido": "node --import tsx ejemplo/partido.ts"
  },
  "dependencies": {
    "pdfkit": "^0.15.0",
    "@aws-sdk/client-s3": "^3.620.0",
    "@aws-sdk/lib-storage": "^3.620.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pdfkit": "^0.13.4",
    "tsup": "^8.1.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.3"
  },
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/QualityGB/padron-pdf.git"
  }
}